# PostgreSQL（必填）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# 管理端 JWT（必填，生产请用长随机串）
ADMIN_JWT_SECRET="CHANGE_ME_TO_RANDOM"

# 浏览器访问前端的 Origin（CORS / Cookie）
# 生产环境请改为实际前端地址，例如 https://www.example.com
WEB_ORIGIN="http://localhost:3000"
# 多个前端 Origin 时逗号分隔（可选，用于 CORS）
# WEB_ORIGINS="https://www.example.com,https://staging.example.com"

# API 监听端口（可选，默认 8787）
API_PORT=8787

# 对外站点根地址（可选）
# - 前端与 API 同域名时：可不配置，上传接口会返回相对路径 /uploads/...，天然适配 https
# - 仅当前端与 API 不同域名、或必须把绝对 URL 写入数据库时：填写无尾斜杠的 https 根地址
# PUBLIC_APP_URL="https://www.example.com"

# 生产部署（PM2）建议：
# - 线上用 `npm run start:api`（不要 `dev:api` / tsx watch）
# - 参考 deploy/ecosystem.config.example.cjs

# 后台入口（可选，但生产强烈建议配置）
# - 配置后：先访问一次 `https://你的域名/?admin_key=你的密钥`（或任意页面路径带该参数）
#   才会在导航栏显示后台入口按钮，并允许 `/admin`
# - 不配置：生产环境默认不展示后台入口（开发环境仍可直接进入）
# VITE_ADMIN_ENTRY_SECRET="CHANGE_ME_LONG_RANDOM"

# DeepSeek：在线 AI 咨询（可选；不配置则使用关键词匹配 + 兜底回复）
DEEPSEEK_API_KEY=""

# 前端构建（静态托管）时的 API 根地址：
# - 同源：Nginx 等将 /api、/uploads 反代到本仓库的 Node API 时，可省略，生产构建将使用相对路径 /api
# - 跨域：前端与 API 不同域名时必填，须含协议、无尾斜杠，例如 https://api.example.com
# 开发环境通常可省略（Vite 已代理 /api）
# VITE_API_BASE="https://api.example.com"
