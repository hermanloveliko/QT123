# PostgreSQL（必填）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# 管理端 JWT（必填，生产请用长随机串）
ADMIN_JWT_SECRET="CHANGE_ME_TO_RANDOM"

# 浏览器访问前端的 Origin（CORS / Cookie）
# 生产环境请改为实际前端地址，例如 https://www.example.com
WEB_ORIGIN="http://localhost:3000"
# 多个前端 Origin 时逗号分隔（可选，用于 CORS）
# WEB_ORIGINS="https://www.example.com,https://staging.example.com"

# API 监听端口（可选，默认 8787）
API_PORT=8787

# 对外站点根地址（可选）
# - 前端与 API 同域名时：可不配置，上传接口会返回相对路径 /uploads/...，天然适配 https
# - 仅当前端与 API 不同域名、或必须把绝对 URL 写入数据库时：填写无尾斜杠的 https 根地址
# PUBLIC_APP_URL="https://www.example.com"

# 生产部署（PM2）建议：
# - 线上用 `npm run start:api`（不要 `dev:api` / tsx watch）
# - 参考 deploy/ecosystem.config.example.cjs

# 导航栏是否显示「管理员」入口（可选；不配置=任何环境均不在导航显示，与线上一致）
# - 配置后：先访问 `http://localhost:3000/?admin_key=你的密钥` 或 `https://你的域名/?admin_key=...`
#   本标签页 session 内会显示导航入口（密钥会从地址栏自动去掉）
# - 不配置：导航栏不显示，但仍可直接在浏览器打开 `/admin` 用账号密码登录
# VITE_ADMIN_ENTRY_SECRET="CHANGE_ME_LONG_RANDOM"

# DeepSeek：在线 AI 咨询（可选；不配置则使用关键词匹配 + 兜底回复）
DEEPSEEK_API_KEY=""

# 前端使用的 API 根地址（须含协议、无尾斜杠）：
# - 生产构建且前后端同源（/api 反代）：可省略，将使用相对路径 /api
# - 生产构建且 API 不同域名：构建前必须设置，写入打包结果
# - 本机 npm run dev 但 API 在远程服务器：必须在 .env 设置此项，否则请求会打到本机 Vite 代理 8787 导致 Failed to fetch
# VITE_API_BASE="https://www.example.com"
